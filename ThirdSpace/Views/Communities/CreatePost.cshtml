@using ThirdSpace.Models.Communities

@{
	Layout = "_CommunitiesLayout";
	ViewData["Title"] = "Create a Post";
	ViewData["CurrentCommunityPage"] = "CreatePost";

	var joinedCommunities =
		ViewBag.JoinedCommunities as IEnumerable<Community>
		?? Enumerable.Empty<Community>();
}

<div class="container-fluid px-3 px-lg-4 py-4 text-light">

	<div class="mb-4">

		<div class="text-info text-uppercase small fw-semibold mb-2">
			<i class="bi bi-pencil-square me-2"></i>
			Share Your Thoughts
		</div>

		<h1 class="h2 fw-bold mb-2">
			Create a Post
		</h1>

		<p class="text-secondary mb-0">
			Start a discussion in one of your joined communities.
		</p>

	</div>

	<section class="card bg-dark text-light border-secondary rounded-4 p-3 p-md-4 mb-4">

		<form asp-controller="Communities"
			  asp-action="CreatePost"
			  method="post">

			@Html.AntiForgeryToken()

			<div asp-validation-summary="All"
				 class="text-danger mb-3"></div>

			<div class="mb-3">

				<label for="communityId" class="form-label">
					Select Community <span class="text-danger">*</span>
				</label>

				<select id="communityId"
						name="communityId"
						class="form-select bg-body-tertiary"
						required>

					<option value="">Select Community</option>

					@foreach (var community in joinedCommunities)
					{
						<option value="@community.Id">
							t/@community.Name
						</option>
					}

				</select>

				<div class="form-text text-secondary">
					Choose a community you've joined.
				</div>

			</div>

			<div class="mb-3">

				<label for="postTitle" class="form-label">
					Title <span class="text-danger">*</span>
				</label>


				<input type="text"
					   id="postTitle"
					   name="title"
					   class="form-control bg-body-tertiary"
					   placeholder="Enter post title"
					   maxlength="200"
					   required />


				<div class="mb-4">

					<label for="postBody" class="form-label">
						Body text (optional)
					</label>

<textarea id="postBody"
		  name="body"
		  rows="8"
		  class="form-control bg-body-tertiary"
		  placeholder="Share your thoughts or questions..."></textarea>


				</div>

				<div class="d-flex justify-content-end gap-2">

					<a asp-controller="Communities"
					   asp-action="Index"
					   class="btn btn-outline-light">
						Cancel
					</a>

					<button type="submit"
							class="btn btn-info fw-semibold"
							disabled="@( !joinedCommunities.Any() )">

						Post
						<i class="bi bi-send ms-1"></i>

					</button>

				</div>

				@if (!joinedCommunities.Any())
				{
					<p class="text-warning small mt-3 mb-0">
						You need to join a community before creating a post.
					</p>
				}

		</form>

	</section>

	<section class="card bg-dark text-light border-secondary rounded-4 p-3 p-md-4">

		<h2 class="h5 fw-semibold mb-3">

			<i class="bi bi-shield-check text-info me-2"></i>
			Posting Guidelines

		</h2>

		<p class="text-secondary mb-0">
			Be respectful, stay on topic, and follow your community's rules.
		</p>

	</section>

</div>
