@model IEnumerable<ThirdSpace.Models.FriendRequest>

@{
    Layout = null;
    ViewData["Title"] = "Friend Requests";
}

<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Friend Requests - ThirdSpace</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet" />
</head>

<body class="bg-black text-light">

    <header class="navbar bg-dark border-bottom border-secondary px-4 py-2">

        <a asp-controller="Home"
           asp-action="Index"
           class="navbar-brand">

            <img src="~/images/logo.png"
                 alt="ThirdSpace"
                 width="150" />
        </a>

        <span class="text-info fw-semibold">
            <i class="bi bi-people me-2"></i>
            Friend Requests
        </span>
    </header>

    <div class="container-fluid px-0">
        <div class="row g-0">

            <!-- SIDEBAR -->
            <aside class="col-md-3 col-lg-2 bg-dark border-end border-secondary min-vh-100 p-3">

                <nav class="nav flex-column gap-2">

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="nav-link text-light rounded-3 py-3">
                        <i class="bi bi-house-door me-3"></i>
                        Home
                    </a>

                    <a asp-controller="Explore"
                       asp-action="Index"
                       class="nav-link bg-info bg-opacity-25 text-info rounded-3 py-3">
                        <i class="bi bi-compass me-3"></i>
                        Explore
                    </a>

                    <a asp-controller="Communities"
                       asp-action="Index"
                       class="nav-link text-light rounded-3 py-3">
                        <i class="bi bi-people me-3"></i>
                        Communities
                    </a>

                    <a asp-controller="Marketplace"
                       asp-action="Index"
                       class="nav-link text-light rounded-3 py-3">
                        <i class="bi bi-shop me-3"></i>
                        Marketplace
                    </a>

                </nav>
            </aside>

            <!-- MAIN CONTENT -->
            <main class="col-md-9 col-lg-10 p-3 p-lg-4">

                <div class="mb-4">
                    <h2 class="fw-bold mb-2">
                        Friend Requests
                    </h2>

                    <p class="text-secondary">
                        Accept or reject requests from other
                        ThirdSpace members.
                    </p>
                </div>

                <!-- EXPLORE TABS -->
                <ul class="nav nav-pills gap-2 mb-4">

                    <li class="nav-item">
                        <a asp-controller="Explore"
                           asp-action="Index"
                           class="nav-link text-light">
                            <i class="bi bi-grid-3x3-gap me-2"></i>
                            Explore Posts
                        </a>
                    </li>

                    <li class="nav-item">
                        <a asp-controller="Explore"
                           asp-action="DiscoverPeople"
                           class="nav-link text-light">
                            <i class="bi bi-people me-2"></i>
                            Discover People
                        </a>
                    </li>

                    <li class="nav-item">
                        <a asp-controller="Explore"
                           asp-action="FriendRequests"
                           class="nav-link active bg-info text-dark fw-semibold">
                            <i class="bi bi-person-check me-2"></i>
                            Friend Requests
                        </a>
                    </li>

                </ul>

                <!-- AJAX MESSAGE -->
                <div id="requestMessage"
                     class="alert d-none"
                     role="status"
                     aria-live="polite">
                </div>

                <!-- REQUEST COUNT -->
                <h5 class="fw-semibold mb-3">
                    Pending Requests
                    <span id="requestCount"
                          class="badge text-bg-secondary ms-2">
                        @Model.Count()
                    </span>
                </h5>

                <!-- REQUEST CARDS -->
                <div id="requestsContainer"
                     class="row row-cols-1 row-cols-lg-2 row-cols-xl-3 g-3">

                    @foreach (var request in Model)
                    {
                        <div class="col request-card">

                            <div class="card bg-dark border-secondary rounded-4 h-100">

                                <div class="card-body p-4">

                                    <div class="d-flex align-items-center gap-3 mb-3">

                                        <i class="bi bi-person-circle fs-1 text-info"></i>

                                        <div>
                                            <h5 class="fw-semibold mb-1 text-break">
                                                @(request.Sender?.UserName ?? "ThirdSpace User")
                                            </h5>

                                            <span class="text-secondary small">
                                                Sent @request.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                                            </span>
                                        </div>

                                    </div>

                                    <p class="text-secondary small mb-3">
                                        Wants to connect with you on ThirdSpace.
                                    </p>

                                    <form class="requestActionForm"
                                          asp-controller="Explore"
                                          asp-action="AcceptRequest"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@request.Id" />

                                        <div class="d-flex gap-2">

                                            <button type="submit"
                                                    formaction="@Url.Action("AcceptRequest", "Explore")"
                                                    class="btn btn-info fw-semibold flex-fill acceptButton">
                                                <i class="bi bi-check-lg me-1"></i>
                                                Accept
                                            </button>

                                            <button type="submit"
                                                    formaction="@Url.Action("RejectRequest", "Explore")"
                                                    class="btn btn-outline-danger flex-fill rejectButton">
                                                <i class="bi bi-x-lg me-1"></i>
                                                Reject
                                            </button>

                                        </div>

                                    </form>

                                </div>

                            </div>

                        </div>
                    }

                </div>

                <div id="emptyRequests"
                     class="card bg-dark border-secondary rounded-4 @(Model.Any() ? "d-none" : "")">

                    <div class="card-body text-center py-5">

                        <i class="bi bi-person-check display-4 text-secondary"></i>

                        <h5 class="fw-semibold mt-3">
                            No pending friend requests
                        </h5>

                        <p class="text-secondary mb-3">
                            Your incoming requests will appear here.
                        </p>

                        <a asp-controller="Explore"
                           asp-action="DiscoverPeople"
                           class="btn btn-outline-info">
                            Discover People
                        </a>

                    </div>
                </div>

            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script>
        $(document).ready(function () {

            // AJAX: ACCEPT OR REJECT FRIEND REQUEST
            $(".requestActionForm").on("submit", function (event) {

                event.preventDefault();

                const form = $(this);
                const clickedButton = $(event.originalEvent?.submitter);

                const button = clickedButton.length
                    ? clickedButton
                    : form.find(".acceptButton");

                const card = form.closest(".request-card");
                const messageBox = $("#requestMessage");

                const actionUrl =
                    button.attr("formaction") || form.attr("action");

                const buttons = form.find("button");

                buttons.prop("disabled", true);

                messageBox
                    .addClass("d-none")
                    .removeClass("alert-success alert-danger")
                    .text("");

                $.ajax({
                    url: actionUrl,
                    type: "POST",
                    data: form.serialize(),
                    dataType: "json",

                    headers: {
                        "X-Requested-With": "XMLHttpRequest"
                    },

                    success: function (response) {

                        if (response.success) {

                            messageBox
                                .removeClass("d-none")
                                .addClass("alert-success")
                                .text(response.message);

                            card.remove();

                            const remaining =
                                $(".request-card").length;

                            $("#requestCount").text(remaining);

                            if (remaining === 0) {
                                $("#emptyRequests")
                                    .removeClass("d-none");
                            }

                        } else {

                            buttons.prop("disabled", false);

                            messageBox
                                .removeClass("d-none")
                                .addClass("alert-danger")
                                .text(response.message || "Action failed.");
                        }
                    },

                    error: function (xhr) {

                        buttons.prop("disabled", false);

                        messageBox
                            .removeClass("d-none")
                            .addClass("alert-danger")
                            .text(
                                xhr.responseJSON?.message ||
                                "Unable to update friend request."
                            );
                    }
                });
            });

        });
    </script>

</body>
</html>
