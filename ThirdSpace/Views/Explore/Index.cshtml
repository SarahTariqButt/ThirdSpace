@{
    Layout = null;
    ViewData["Title"] = "Explore";
}

<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">

<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Explore - ThirdSpace</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet" />
</head>

<body class="bg-black text-light">

    <!-- HEADER -->
    <header class="navbar bg-dark border-bottom border-secondary px-4 py-2">

        <a asp-controller="Home"
           asp-action="Index"
           class="navbar-brand">

            <img src="~/images/logo.png"
                 alt="ThirdSpace"
                 width="150" />

        </a>

        <span class="text-info fw-semibold">
            <i class="bi bi-compass me-2"></i>
            Explore
        </span>

    </header>

    <!-- PAGE LAYOUT -->
    <div class="container-fluid px-0">

        <div class="row g-0">

            <!-- LEFT SIDEBAR -->
            <aside class="col-md-3 col-lg-2 bg-dark border-end border-secondary min-vh-100 p-3">

                <nav class="nav flex-column gap-2">

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="nav-link text-light rounded-3 py-3">

                        <i class="bi bi-house-door me-3"></i>
                        Home

                    </a>

                    <a asp-controller="Explore"
                       asp-action="Index"
                       class="nav-link bg-info bg-opacity-25 text-info rounded-3 py-3">

                        <i class="bi bi-compass-fill me-3"></i>
                        Explore

                    </a>

                    <a asp-controller="Communities"
                       asp-action="Index"
                       class="nav-link text-light rounded-3 py-3">

                        <i class="bi bi-people me-3"></i>
                        Communities

                    </a>

                    <a asp-controller="Marketplace"
                       asp-action="Index"
                       class="nav-link text-light rounded-3 py-3">

                        <i class="bi bi-shop me-3"></i>
                        Marketplace

                    </a>

                </nav>

            </aside>

            <!-- MAIN CONTENT -->
            <main class="col-md-9 col-lg-10 p-3 p-lg-4">

                <!-- PAGE HEADING -->
                <div class="mb-4">

                    <h2 class="fw-bold mb-2">
                        Explore
                    </h2>

                    <p class="text-secondary">
                        Discover public posts and connect
                        with new people.
                    </p>

                </div>

                <!-- SEARCH BAR -->
                <form asp-controller="Explore"
                      asp-action="Index"
                      method="get"
                      class="mb-4">

                    <div class="input-group">

                        <span class="input-group-text bg-dark border-secondary">
                            <i class="bi bi-search"></i>
                        </span>

                        <input type="search"
                               name="search"
                               class="form-control bg-dark border-secondary py-3"
                               placeholder="Search public posts..." />

                        <button type="submit"
                                class="btn btn-info px-4">

                            Search

                        </button>

                    </div>

                </form>

                <!-- EXPLORE NAVIGATION -->
                <ul class="nav nav-pills gap-2 mb-4">

                    <li class="nav-item">

                        <a asp-controller="Explore"
                           asp-action="Index"
                           class="nav-link active bg-info text-dark fw-semibold">

                            <i class="bi bi-grid-3x3-gap me-2"></i>
                            Explore Posts

                        </a>

                    </li>

                    <li class="nav-item">

                        <a asp-controller="Explore"
                           asp-action="DiscoverPeople"
                           class="nav-link text-light">

                            <i class="bi bi-people me-2"></i>
                            Discover People

                        </a>

                    </li>

                    <li class="nav-item">
                        <a asp-controller="Explore"
                           asp-action="FriendRequests"
                           class="nav-link text-light">

                            <i class="bi bi-person-check me-2"></i>
                            Friend Requests

                        </a>
                    </li>


                </ul>

                <!-- PUBLIC POSTS GRID -->
                <section class="mb-4">

                    <h5 class="fw-semibold mb-3">
                        Discover Posts
                    </h5>

                    <div class="row row-cols-2 row-cols-md-3 row-cols-xl-4 g-3">

                        @* Public photo posts will be rendered here
                           after connecting the database.

                           Each post will have a Bootstrap card
                           containing its image. Clicking the card
                           will open a Bootstrap modal showing the
                           complete post and author information. *@

                    </div>

                    <!-- EMPTY STATE -->
                    <div class="card bg-dark border-secondary rounded-4">

                        <div class="card-body text-center py-5">

                            <i class="bi bi-images display-4 text-secondary"></i>

                            <h5 class="fw-semibold mt-3">
                                No posts to explore yet
                            </h5>

                            <p class="text-secondary mb-0">
                                Public photo posts will appear here.
                            </p>

                        </div>

                    </div>

                </section>

            </main>

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
