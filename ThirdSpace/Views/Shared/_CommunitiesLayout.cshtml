@using ThirdSpace.Models.Communities

@{
    Layout = null;

    var myCommunities =
        ViewBag.MyCommunities as IEnumerable<Community>
        ?? Enumerable.Empty<Community>();

    var popularCommunities =
        ViewBag.PopularCommunities as IEnumerable<Community>
        ?? Enumerable.Empty<Community>();

    var currentPage =
        ViewData["CurrentCommunityPage"] as string ?? "";

    var currentCommunityId =
        ViewContext.RouteData.Values["id"]?.ToString();
}

<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - ThirdSpace</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet" />
</head>

<body class="bg-black text-light">

    <header class="navbar bg-dark border-bottom border-secondary px-3 px-lg-4 py-2">

        <a asp-controller="Home"
           asp-action="Index"
           class="navbar-brand m-0">

            <img src="~/images/logo.png"
                 alt="ThirdSpace"
                 width="150" />
        </a>

        <div class="d-flex align-items-center gap-3">

            <a asp-controller="Communities"
               asp-action="CreatePost"
               class="btn btn-info fw-semibold rounded-pill px-3">

                <i class="bi bi-plus-lg me-1"></i>
                Create Post
            </a>

            <div class="dropdown">

                <button class="btn btn-dark"
                        type="button"
                        data-bs-toggle="dropdown"
                        aria-expanded="false">

                    <i class="bi bi-person-circle fs-4"></i>

                </button>

                <ul class="dropdown-menu dropdown-menu-end">

                    <li>
                        <span class="dropdown-item-text text-info">
                            @User.Identity?.Name
                        </span>
                    </li>

                    <li>
                        <hr class="dropdown-divider" />
                    </li>

                    <li>
                        <form asp-controller="Account"
                              asp-action="Logout"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="dropdown-item">
                                Log Out
                            </button>

                        </form>
                    </li>

                </ul>

            </div>

        </div>

    </header>

    <div class="container-fluid px-0">

        <div class="row g-0">


            <aside class="col-lg-3 col-xl-2 bg-dark border-end border-secondary p-3 min-vh-100">

                <div class="d-flex justify-content-between align-items-center gap-2 mb-4">

                    <h5 class="fw-bold mb-0 text-nowrap">
                        Communities
                    </h5>

                    <button type="button"
                            class="btn btn-sm text-info border-0 flex-shrink-0"
                            data-bs-toggle="modal"
                            data-bs-target="#createCommunityModal"
                            title="Create Community"
                            aria-label="Create Community">
                        <i class="bi bi-plus-lg fs-5"></i>
                    </button>

                </div>

                <div class="border-top border-secondary pt-3">

                    <h6 class="fw-semibold text-secondary mb-3">
                        My Communities
                    </h6>

                    @if (myCommunities.Any())
                    {
                        <nav class="nav flex-column gap-2">

                            @foreach (var community in myCommunities)
                            {
                                var active =
                                ViewContext.RouteData.Values["action"]?.ToString() == "Details" &&
                                ViewContext.RouteData.Values["id"]?.ToString() == community.Id.ToString();

                                <a asp-controller="Communities"
                                   asp-action="Details"
                                   asp-route-id="@community.Id"
                                   class="nav-link rounded-3 d-flex align-items-center gap-2 px-3 py-2 @(active ? "bg-info bg-opacity-25 text-info" : "text-light")">

                                    <i class="bi bi-hash flex-shrink-0"></i>

                                    <span class="text-truncate">
                                        t/@community.Name
                                    </span>

                                </a>
                            }

                        </nav>
                    }
                    else
                    {
                        <p class="small text-secondary mb-0">
                            No joined communities yet.
                        </p>
                    }

                </div>

            </aside>


            <main class="col-lg-6 col-xl-7 p-3 p-md-4">

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">
                        @TempData["Error"]
                    </div>
                }

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">
                        @TempData["Success"]
                    </div>
                }

                @RenderBody()

            </main>

            <aside class="col-lg-3 col-xl-3 border-start border-secondary p-3">

                <div class="card bg-dark border-secondary rounded-4">

                    <div class="card-body">

                        <h5 class="fw-semibold mb-3">

                            <i class="bi bi-fire text-info me-2"></i>
                            Popular Communities

                        </h5>

                        @if (popularCommunities.Any())
                        {
                            @foreach (var community in popularCommunities)
                            {
                                <div class="d-flex align-items-center gap-3 mb-3">

                                    <span class="rounded-circle bg-secondary bg-opacity-25 p-2">

                                        <i class="bi bi-hash text-info"></i>

                                    </span>

                                    <div class="flex-grow-1">

                                        <a asp-controller="Communities"
                                           asp-action="Details"
                                           asp-route-id="@community.Id"
                                           class="text-info text-decoration-none fw-semibold">

                                            t/@community.Name

                                        </a>

                                    </div>

                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-secondary mb-0">
                                No communities available yet.
                            </p>
                        }

                    </div>

                </div>

            </aside>

        </div>

    </div>

    <div class="modal fade"
         id="createCommunityModal"
         tabindex="-1"
         aria-labelledby="createCommunityModalLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content bg-dark text-light border-secondary rounded-4">

                <div class="modal-header border-secondary">

                    <h5 class="modal-title fw-semibold"
                        id="createCommunityModalLabel">

                        Create Community

                    </h5>

                    <button type="button"
                            class="btn-close btn-close-white"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>

                </div>

                <form asp-controller="Communities"
                      asp-action="CreateCommunity"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div class="modal-body">

                        <label for="communityName"
                               class="form-label fw-semibold">

                            Community Name

                        </label>

                        <input type="text"
                               id="communityName"
                               name="name"
                               class="form-control bg-body-tertiary"
                               placeholder="Enter community name"
                               maxlength="100"
                               required />

                        <div class="form-text text-secondary mt-2">
                            Choose a unique name for your community.
                        </div>

                    </div>

                    <div class="modal-footer border-secondary">

                        <button type="button"
                                class="btn btn-outline-light"
                                data-bs-dismiss="modal">

                            Cancel

                        </button>

                        <button type="submit"
                                class="btn btn-info fw-semibold">

                            Create Community

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
