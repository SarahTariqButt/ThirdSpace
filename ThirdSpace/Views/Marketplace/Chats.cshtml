@model IEnumerable<ThirdSpace.Models.Marketplace.Chat>
@using ThirdSpace.Models.Marketplace

@{
    Layout = null;
    ViewData["Title"] = "Chats with Sellers";

    var chats = Model.ToList();

    int? selectedChatId = ViewBag.SelectedChatId;
    string currentUserId = ViewBag.UserId ?? "";

    var messages = ViewBag.Messages as IEnumerable<ChatMessage>
        ?? Enumerable.Empty<ChatMessage>();

    var selectedChat = chats.FirstOrDefault(c => c.Id == selectedChatId);
}

<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - ThirdSpace</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
</head>

<body class="bg-black text-light">

    <header class="navbar bg-dark border-bottom border-secondary px-3 px-lg-4 py-2">

        <a asp-controller="Home"
           asp-action="Index"
           class="navbar-brand m-0">

            <img src="~/images/logo.png"
                 alt="ThirdSpace"
                 width="140" />
        </a>

        <a asp-controller="Marketplace"
           asp-action="CreateListings"
           class="btn btn-info btn-sm fw-semibold rounded-pill px-3">

            <i class="bi bi-plus-lg me-1"></i>Sell Item
        </a>

    </header>

    <div class="container-fluid px-0">
        <div class="row g-0">

            <aside class="col-lg-3 col-xl-2 bg-dark border-end border-secondary p-3">

                <h5 class="fw-bold mb-3">Marketplace</h5>

                <nav class="nav flex-column gap-2">

                    <a asp-controller="Marketplace"
                       asp-action="Index"
                       class="nav-link rounded-3 text-light">

                        <i class="bi bi-grid me-2"></i>Browse All
                    </a>

                    <a asp-controller="Marketplace"
                       asp-action="SearchListings"
                       class="nav-link rounded-3 text-light">

                        <i class="bi bi-search me-2"></i>Search Listings
                    </a>

                    <a asp-controller="Marketplace"
                       asp-action="YourListings"
                       class="nav-link rounded-3 text-light">

                        <i class="bi bi-bag me-2"></i>Your Listings
                    </a>

                    <a asp-controller="Marketplace"
                       asp-action="Chats"
                       class="nav-link rounded-3 bg-info bg-opacity-25 text-info">

                        <i class="bi bi-chat-dots me-2"></i>Chats with Sellers
                    </a>

                </nav>

            </aside>

            <main class="col-lg-9 col-xl-10 p-3 p-md-4 min-vh-100">

                <div class="mb-4">

                    <h2 class="fw-bold mb-1">
                        Chats with Sellers
                    </h2>

                    <p class="text-secondary">
                        Conversations about Marketplace items.
                    </p>

                </div>

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">
                        @TempData["Error"]
                    </div>
                }

                <div class="row g-3">

                    <div class="col-md-4">

                        <section class="card bg-dark border-secondary rounded-4 h-100 p-3">

                            <h5 class="mb-3">
                                Conversations
                            </h5>

                            @if (chats.Any())
                            {
                                <div class="list-group list-group-flush">

                                    @foreach (var chat in chats)
                                    {
                                        var otherUser = chat.BuyerId == currentUserId
                                        ? chat.Seller
                                        : chat.Buyer;

                                        var otherUserName = otherUser?.Name
                                        ?? otherUser?.UserName
                                        ?? "User";

                                        <a asp-controller="Marketplace"
                                           asp-action="Chats"
                                           asp-route-id="@chat.Id"
                                           class="list-group-item list-group-item-action bg-dark text-light border-secondary @(selectedChatId == chat.Id ? "border-info" : "")">

                                            <div class="d-flex gap-2 align-items-start">

                                                <i class="bi bi-person-circle fs-3"></i>

                                                <div class="overflow-hidden">

                                                    <strong class="d-block text-truncate">
                                                        @otherUserName
                                                    </strong>

                                                    <small class="d-block text-info text-truncate">
                                                        @chat.Listing?.Title
                                                    </small>

                                                    <small class="text-secondary">
                                                        @chat.CreatedAt.ToString("dd MMM yyyy")
                                                    </small>

                                                </div>

                                            </div>

                                        </a>
                                    }

                                </div>
                            }
                            else
                            {
                                <p class="text-secondary small mb-0">
                                    No conversations yet. Open a listing
                                    and select Chat with Seller.
                                </p>
                            }

                        </section>

                    </div>

                    <div class="col-md-8">

                        <section class="card bg-dark border-secondary rounded-4 h-100 p-3">

                            @if (selectedChat != null)
                            {
                                <div class="border-bottom border-secondary pb-3 mb-3">

                                    <h5 class="mb-1">
                                        Conversation
                                    </h5>

                                    <small class="text-info">
                                        @selectedChat.Listing?.Title
                                    </small>

                                </div>

                                <div class="d-flex flex-column gap-3 mb-4"
                                     style="min-height: 300px; max-height: 450px; overflow-y: auto;">

                                    @if (messages.Any())
                                    {
                                        @foreach (var message in messages)
                                        {
                                            bool isMine = message.SenderId == currentUserId;

                                            <div class="d-flex @(isMine ? "justify-content-end" : "justify-content-start")">

                                                <div class="rounded-4 border px-3 py-2 @(isMine ? "border-info bg-info bg-opacity-10" : "border-secondary bg-body-tertiary")"
                                                     style="max-width: 80%; overflow-wrap: anywhere;">

                                                    <div>
                                                        @message.Content
                                                    </div>

                                                    <small class="d-block text-secondary mt-1 text-end">
                                                        @message.SentAt.ToLocalTime().ToString("dd MMM, hh:mm tt")
                                                    </small>

                                                </div>

                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="text-center text-secondary my-auto">

                                            <i class="bi bi-chat-square-text fs-1"></i>

                                            <p class="mt-2">
                                                No messages yet. Start the conversation.
                                            </p>

                                        </div>
                                    }

                                </div>

                                <form asp-controller="Marketplace"
                                      asp-action="SendMessage"
                                      method="post"
                                      class="mt-auto">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="chatId"
                                           value="@selectedChat.Id" />

                                    <div class="input-group">

                                        <input type="text"
                                               name="content"
                                               class="form-control bg-body-tertiary"
                                               placeholder="Type a message..."
                                               maxlength="2000"
                                               required
                                               aria-label="Message" />

                                        <button type="submit"
                                                class="btn btn-info">

                                            <i class="bi bi-send"></i>

                                        </button>

                                    </div>

                                </form>
                            }
                            else
                            {
                                <div class="text-center py-5">

                                    <i class="bi bi-chat-dots fs-1 text-secondary"></i>

                                    <h5 class="mt-3">
                                        Select a conversation
                                    </h5>

                                    <p class="text-secondary">
                                        Messages will appear here.
                                    </p>

                                </div>
                            }

                        </section>

                    </div>

                </div>

            </main>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
