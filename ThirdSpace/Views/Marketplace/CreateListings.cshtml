@model ThirdSpace.ViewModels.MarketplaceListingInput

@{
    Layout = null;
    ViewData["Title"] = "Create a Listing";
}

<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - ThirdSpace</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
</head>

<body class="bg-black text-light">

    <header class="navbar bg-dark border-bottom border-secondary px-3 px-lg-4 py-2">

        <a asp-controller="Home"
           asp-action="Index"
           class="navbar-brand m-0">

            <img src="~/images/logo.png"
                 alt="ThirdSpace"
                 width="140" />
        </a>

        <a asp-controller="Marketplace"
           asp-action="CreateListings"
           class="btn btn-info btn-sm fw-semibold rounded-pill px-3">

            <i class="bi bi-plus-lg me-1"></i>Sell Item
        </a>

    </header>

    <div class="container-fluid px-0">

        <div class="row g-0">

            <aside class="col-lg-3 col-xl-2 bg-dark border-end border-secondary p-3">

                <h5 class="fw-bold mb-3">
                    Marketplace
                </h5>

                <nav class="nav flex-column gap-2">

                    <a asp-controller="Marketplace"
                       asp-action="Index"
                       class="nav-link rounded-3 text-light">

                        <i class="bi bi-grid me-2"></i>Browse All
                    </a>

                    <a asp-controller="Marketplace"
                       asp-action="SearchListings"
                       class="nav-link rounded-3 text-light">

                        <i class="bi bi-search me-2"></i>Search Listings
                    </a>

                    <a asp-controller="Marketplace"
                       asp-action="YourListings"
                       class="nav-link rounded-3 text-light">

                        <i class="bi bi-bag me-2"></i>Your Listings
                    </a>

                    <a asp-controller="Marketplace"
                       asp-action="Chats"
                       class="nav-link rounded-3 text-light">

                        <i class="bi bi-chat-dots me-2"></i>Chats with Sellers
                    </a>

                </nav>

            </aside>

            <main class="col-lg-9 col-xl-10 p-3 p-md-4 min-vh-100">

                <div class="mb-4">

                    <h2 class="fw-bold mb-1">
                        Create a Listing
                    </h2>

                    <p class="text-secondary mb-0">
                        Add your item's details.
                    </p>

                </div>

                <section class="card bg-dark border-secondary rounded-4 p-3 p-md-4">

                    <form asp-controller="Marketplace"
                          asp-action="CreateListings"
                          method="post"
                          enctype="multipart/form-data">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="All"
                             class="text-danger mb-3"></div>

                        <div class="mb-3">

                            <label asp-for="Title"
                                   class="form-label">
                                Product Title *
                            </label>

                            <input asp-for="Title"
                                   class="form-control bg-body-tertiary"
                                   placeholder="What are you selling?"
                                   maxlength="150"
                                   required />

                            <span asp-validation-for="Title"
                                  class="text-danger small"></span>

                        </div>

                        <div class="row g-3 mb-3">

                            <div class="col-md-6">

                                <label asp-for="Price"
                                       class="form-label">
                                    Price (PKR) *
                                </label>

                                <input asp-for="Price"
                                       type="number"
                                       min="0.01"
                                       max="999999999.99"
                                       step="0.01"
                                       class="form-control bg-body-tertiary"
                                       placeholder="Enter price"
                                       required />

                                <span asp-validation-for="Price"
                                      class="text-danger small"></span>

                            </div>

                            <div class="col-md-6">

                                <label asp-for="Condition"
                                       class="form-label">
                                    Condition *
                                </label>

                                <select asp-for="Condition"
                                        class="form-select bg-body-tertiary"
                                        required>

                                    <option value="">Select condition</option>
                                    <option value="New">New</option>
                                    <option value="Like New">Like New</option>
                                    <option value="Good">Good</option>
                                    <option value="Fair">Fair</option>

                                </select>

                                <span asp-validation-for="Condition"
                                      class="text-danger small"></span>

                            </div>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Category"
                                   class="form-label">
                                Category *
                            </label>

                            <select asp-for="Category"
                                    class="form-select bg-body-tertiary"
                                    required>

                                <option value="">Select category</option>
                                <option value="Electronics">Electronics</option>
                                <option value="Furniture">Furniture</option>
                                <option value="Clothing">Clothing</option>
                                <option value="Books">Books</option>
                                <option value="Other">Other</option>

                            </select>

                            <span asp-validation-for="Category"
                                  class="text-danger small"></span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Description"
                                   class="form-label">
                                Description *
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control bg-body-tertiary"
                                      rows="4"
                                      maxlength="2000"
                                      placeholder="Describe the item"
                                      required></textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger small"></span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Location"
                                   class="form-label">
                                Location *
                            </label>

                            <input asp-for="Location"
                                   class="form-control bg-body-tertiary"
                                   placeholder="City or area"
                                   required />

                            <span asp-validation-for="Location"
                                  class="text-danger small"></span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="Photo"
                                   class="form-label">
                                Product Photo
                            </label>

                            <input asp-for="Photo"
                                   type="file"
                                   class="form-control bg-body-tertiary"
                                   accept="image/jpeg,image/png,image/webp" />

                            <span asp-validation-for="Photo"
                                  class="text-danger small"></span>

                            <div class="form-text">
                                JPG, PNG, or WEBP. Maximum 5 MB.
                            </div>

                        </div>

                        <div class="d-flex justify-content-end gap-2">

                            <a asp-controller="Marketplace"
                               asp-action="Index"
                               class="btn btn-outline-light">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-info fw-semibold">

                                <i class="bi bi-check-circle me-1"></i>
                                Publish Listing

                            </button>

                        </div>

                    </form>

                </section>

            </main>

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
