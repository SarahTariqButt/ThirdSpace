@model IEnumerable<ThirdSpace.Models.Marketplace.Listing>

@{
    Layout = null;
    ViewData["Title"] = "Your Listings";
}

<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - ThirdSpace</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
</head>

<body class="bg-black text-light">

    <header class="navbar bg-dark border-bottom border-secondary px-3 px-lg-4 py-2">
        <a asp-controller="Home" asp-action="Index" class="navbar-brand m-0">
            <img src="~/images/logo.png" alt="ThirdSpace" width="140" />
        </a>

        <a asp-controller="Marketplace"
           asp-action="CreateListings"
           class="btn btn-info btn-sm fw-semibold rounded-pill px-3">
            <i class="bi bi-plus-lg me-1"></i>Sell Item
        </a>
    </header>

    <div class="container-fluid px-0">
        <div class="row g-0">

            <aside class="col-lg-3 col-xl-2 bg-dark border-end border-secondary p-3">
                <h5 class="fw-bold mb-3">Marketplace</h5>

                <nav class="nav flex-column gap-2">

                    <a asp-controller="Marketplace"
                       asp-action="Index"
                       class="nav-link rounded-3 text-light">
                        <i class="bi bi-grid me-2"></i>Browse All
                    </a>

                    <a asp-controller="Marketplace"
                       asp-action="SearchListings"
                       class="nav-link rounded-3 text-light">
                        <i class="bi bi-search me-2"></i>Search Listings
                    </a>

                    <a asp-controller="Marketplace"
                       asp-action="YourListings"
                       class="nav-link rounded-3 bg-info bg-opacity-25 text-info">
                        <i class="bi bi-bag me-2"></i>Your Listings
                    </a>

                    <a asp-controller="Marketplace"
                       asp-action="Chats"
                       class="nav-link rounded-3 text-light">
                        <i class="bi bi-chat-dots me-2"></i>Chats with Sellers
                    </a>

                </nav>
            </aside>

            <main class="col-lg-9 col-xl-10 p-3 p-md-4 min-vh-100">

                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">

                    <div>
                        <h2 class="fw-bold mb-1">Your Listings</h2>
                        <p class="text-secondary mb-0">
                            Manage the items you sell.
                        </p>
                    </div>

                    <a asp-controller="Marketplace"
                       asp-action="CreateListings"
                       class="btn btn-outline-info">
                        <i class="bi bi-plus-lg me-1"></i>New Listing
                    </a>

                </div>

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">
                        @TempData["Success"]
                    </div>
                }

                @if (Model.Any())
                {
                    <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-3 row-cols-xxl-4 g-3">

                        @foreach (var listing in Model)
                        {
                            <div class="col">
                                <partial name="_PostCardLayout"
                                         model="listing" />
                            </div>
                        }

                    </div>
                }
                else
                {
                    <div class="card bg-dark border-secondary rounded-4 text-center p-5">

                        <i class="bi bi-inboxes fs-1 text-secondary"></i>

                        <h5 class="mt-3">You have no listings</h5>

                        <p class="text-secondary mb-3">
                            Items you publish will appear here.
                        </p>

                        <a asp-controller="Marketplace"
                           asp-action="CreateListings"
                           class="btn btn-info align-self-center">
                            <i class="bi bi-plus-lg me-1"></i>Create Listing
                        </a>

                    </div>
                }

            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
