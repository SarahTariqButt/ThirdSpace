@model IEnumerable<ThirdSpace.Models.Marketplace.Listing>

@{
    Layout = null;
    ViewData["Title"] = "Search Listings";
}

<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - ThirdSpace</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet" />
</head>

<body class="bg-black text-light">

    <!-- HEADER -->
    <header class="navbar bg-dark border-bottom border-secondary px-3 px-lg-4 py-2">

        <a asp-controller="Home"
           asp-action="Index"
           class="navbar-brand m-0">

            <img src="~/images/logo.png"
                 alt="ThirdSpace"
                 width="140" />

        </a>

        <a asp-controller="Marketplace"
           asp-action="CreateListings"
           class="btn btn-info btn-sm fw-semibold rounded-pill px-3">

            <i class="bi bi-plus-lg me-1"></i>
            Sell Item

        </a>

    </header>

    <div class="container-fluid px-0">

        <div class="row g-0">

            <!-- SIDEBAR -->
            <aside class="col-lg-3 col-xl-2 bg-dark border-end border-secondary p-3">

                <h5 class="fw-bold mb-3">
                    Marketplace
                </h5>

                <nav class="nav flex-column gap-2">

                    <a asp-controller="Marketplace"
                       asp-action="Index"
                       class="nav-link rounded-3 text-light">

                        <i class="bi bi-grid me-2"></i>
                        Browse All

                    </a>

                    <a asp-controller="Marketplace"
                       asp-action="SearchListings"
                       class="nav-link rounded-3 bg-info bg-opacity-25 text-info">

                        <i class="bi bi-search me-2"></i>
                        Search Listings

                    </a>

                    <a asp-controller="Marketplace"
                       asp-action="YourListings"
                       class="nav-link rounded-3 text-light">

                        <i class="bi bi-bag me-2"></i>
                        Your Listings

                    </a>

                    <a asp-controller="Marketplace"
                       asp-action="Chats"
                       class="nav-link rounded-3 text-light">

                        <i class="bi bi-chat-dots me-2"></i>
                        Chats with Sellers

                    </a>

                </nav>

            </aside>

            <!-- MAIN CONTENT -->
            <main class="col-lg-9 col-xl-10 p-3 p-md-4 min-vh-100">

                <div class="mb-4">

                    <h2 class="fw-bold mb-1">
                        Search Listings
                    </h2>

                    <p class="text-secondary">
                        Search products by name, category,
                        location, or price.
                    </p>

                </div>

                <!-- AJAX SEARCH FORM -->
                <form id="searchForm"
                      asp-controller="Marketplace"
                      asp-action="SearchListings"
                      method="get"
                      class="card bg-dark border-secondary rounded-4 mb-4">

                    <div class="card-body p-3 p-md-4">

                        <div class="row g-3">

                            <!-- SEARCH TEXT -->
                            <div class="col-12">

                                <label for="query"
                                       class="form-label fw-semibold">
                                    Search Products
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text bg-body-tertiary border-secondary">
                                        <i class="bi bi-search"></i>
                                    </span>

                                    <input type="search"
                                           id="query"
                                           name="query"
                                           value="@ViewBag.Query"
                                           class="form-control bg-body-tertiary border-secondary"
                                           placeholder="Search products..." />

                                </div>

                            </div>

                            <!-- CATEGORY -->
                            <div class="col-md-4">

                                <label for="category"
                                       class="form-label fw-semibold">
                                    Category
                                </label>

                                <input type="text"
                                       id="category"
                                       name="category"
                                       value="@ViewBag.Category"
                                       class="form-control bg-body-tertiary border-secondary"
                                       placeholder="e.g. Electronics" />

                            </div>

                            <!-- MIN PRICE -->
                            <div class="col-md-4">

                                <label for="minPrice"
                                       class="form-label fw-semibold">
                                    Minimum Price
                                </label>

                                <input type="number"
                                       id="minPrice"
                                       name="minPrice"
                                       value="@ViewBag.MinPrice"
                                       min="0"
                                       step="0.01"
                                       class="form-control bg-body-tertiary border-secondary"
                                       placeholder="Min price" />

                            </div>

                            <!-- MAX PRICE -->
                            <div class="col-md-4">

                                <label for="maxPrice"
                                       class="form-label fw-semibold">
                                    Maximum Price
                                </label>

                                <input type="number"
                                       id="maxPrice"
                                       name="maxPrice"
                                       value="@ViewBag.MaxPrice"
                                       min="0"
                                       step="0.01"
                                       class="form-control bg-body-tertiary border-secondary"
                                       placeholder="Max price" />

                            </div>

                            <div class="col-12 d-flex flex-wrap gap-2">

                                <button type="submit"
                                        id="searchButton"
                                        class="btn btn-info fw-semibold px-4">

                                    <i class="bi bi-search me-1"></i>
                                    Search

                                </button>

                                <button type="button"
                                        id="clearButton"
                                        class="btn btn-outline-secondary px-4">

                                    Clear Filters

                                </button>

                            </div>

                        </div>

                    </div>

                </form>

                <!-- ERROR MESSAGE -->
                <div id="searchError"
                     class="alert alert-danger d-none"
                     role="alert">
                </div>

                <!-- LOADING MESSAGE -->
                <div id="searchLoading"
                     class="text-info mb-3 d-none"
                     role="status"
                     aria-live="polite">

                    <span class="spinner-border spinner-border-sm me-2"></span>
                    Searching listings...

                </div>

                <!-- RESULTS -->
                <div id="searchResults" aria-live="polite">

                    <partial name="_SearchListingResults"
                             model="Model" />

                </div>

            </main>

        </div>

    </div>

    <!-- BOOTSTRAP -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- JQUERY -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script>
        $(document).ready(function () {

            const form = $("#searchForm");
            const searchButton = $("#searchButton");
            const loading = $("#searchLoading");
            const errorBox = $("#searchError");

            function searchListings() {

                if (!form[0].reportValidity()) {
                    return;
                }

                const min = $("#minPrice").val();
                const max = $("#maxPrice").val();

                if (min !== "" && max !== "" &&
                    Number(min) > Number(max)) {

                    errorBox
                        .removeClass("d-none")
                        .text("Minimum price cannot exceed maximum price.");

                    return;
                }

                errorBox
                    .addClass("d-none")
                    .text("");

                loading.removeClass("d-none");
                searchButton.prop("disabled", true);

                $.ajax({

                    url: form.attr("action"),

                    type: "GET",

                    data: form.serialize(),

                    dataType: "html",

                    headers: {
                        "X-Requested-With": "XMLHttpRequest"
                    },

                    success: function (response) {

                        $("#searchResults").html(response);
                    },

                    error: function (xhr) {

                        const message =
                            xhr.status === 400
                                ? xhr.responseText
                                : "Unable to search listings. Please try again.";

                        errorBox
                            .removeClass("d-none")
                            .text(message);
                    },

                    complete: function () {

                        loading.addClass("d-none");
                        searchButton.prop("disabled", false);
                    }

                });
            }

            // AJAX form submission
            form.on("submit", function (event) {

                event.preventDefault();
                searchListings();

            });

            // Clear filters and reload all listings via AJAX
            $("#clearButton").on("click", function () {

                form[0].reset();

                $("#query").val("");
                $("#category").val("");
                $("#minPrice").val("");
                $("#maxPrice").val("");

                searchListings();
            });

        });
    </script>

</body>
</html>
