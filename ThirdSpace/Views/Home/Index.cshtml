@model IEnumerable<ThirdSpace.Models.Home.Post>

@{
    Layout = null;
    ViewData["Title"] = "Home";
}

<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">

<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Home - ThirdSpace</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet">
</head>

<body class="bg-black text-light">

    <header class="navbar bg-dark border-bottom border-secondary px-4 py-1">

        <a asp-controller="Home"
           asp-action="Index"
           class="navbar-brand">

            <img src="~/images/logo.png"
                 alt="ThirdSpace Logo"
                 width="150">

        </a>

        <div class="d-flex align-items-center gap-4">

            <a asp-controller="Explore"
               asp-action="FriendRequests"
               class="text-light fs-4"
               aria-label="Friend requests">

                <i class="bi bi-bell"></i>

            </a>

            <div class="dropdown">

                <button class="btn btn-dark rounded-circle"
                        type="button"
                        data-bs-toggle="dropdown"
                        aria-expanded="false"
                        aria-label="Profile menu">

                    <i class="bi bi-person-circle fs-4"></i>

                </button>

                <ul class="dropdown-menu dropdown-menu-end">

                    <li>
                        <span class="dropdown-item-text text-info">
                            @User.Identity?.Name
                        </span>
                    </li>

                    <li>
                        <hr class="dropdown-divider">
                    </li>

                    <li>
                        <span class="dropdown-item-text text-secondary">
                            View Profile
                        </span>
                    </li>

                    <li>
                        <a asp-controller="Explore"
                           asp-action="FriendRequests"
                           class="dropdown-item">

                            Friends & Requests

                        </a>
                    </li>

                    <li>
                        <span class="dropdown-item-text text-secondary">
                            Edit Profile
                        </span>
                    </li>

                    <li>
                        <hr class="dropdown-divider">
                    </li>

                    <li>
                        <form asp-controller="Account"
                              asp-action="Logout"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="dropdown-item">

                                Log Out

                            </button>

                        </form>
                    </li>

                </ul>

            </div>

        </div>

    </header>

    <div class="container-fluid px-0">

        <div class="row g-0">

            <aside class="col-md-3 col-lg-2 bg-dark border-end border-secondary min-vh-100 px-2 py-3">

                <nav class="nav flex-column gap-2">

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="nav-link active bg-info bg-opacity-25 text-info rounded-3 py-3"
                       aria-current="page">

                        <i class="bi bi-house-door-fill me-3"></i>
                        Home

                    </a>

                    <a asp-controller="Explore"
                       asp-action="Index"
                       class="nav-link text-light rounded-3 py-3">

                        <i class="bi bi-compass me-3"></i>
                        Explore

                    </a>

                    <a asp-controller="Communities"
                       asp-action="Index"
                       class="nav-link text-light rounded-3 py-3">

                        <i class="bi bi-people me-3"></i>
                        Communities

                    </a>

                    <a asp-controller="Marketplace"
                       asp-action="Index"
                       class="nav-link text-light rounded-3 py-3">

                        <i class="bi bi-shop me-3"></i>
                        Marketplace

                    </a>

                </nav>

            </aside>

            <main class="col-md-9 col-lg-10 p-4">

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">
                        @TempData["Error"]
                    </div>
                }

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">
                        @TempData["Success"]
                    </div>
                }

                <section class="card bg-dark border-secondary rounded-4 mb-3">

                    <div class="card-body p-3">

                        <h6 class="fw-semibold mb-3">
                            Stories
                        </h6>

                        <div class="d-flex align-items-start gap-3">

                            <div class="text-center flex-shrink-0">

                                <button type="button"
                                        class="btn btn-outline-info rounded-circle p-3"
                                        aria-label="Add story"
                                        disabled>

                                    <i class="bi bi-plus-lg fs-4"></i>

                                </button>

                                <small class="d-block mt-2">
                                    Your Story
                                </small>

                            </div>

                        </div>

                    </div>

                </section>

                <section class="card bg-dark border-secondary rounded-4 mb-3">

                    <div class="card-body p-3">

                        <div class="d-flex align-items-center gap-3">

                            <i class="bi bi-person-circle fs-1 text-secondary"></i>

                            <button type="button"
                                    class="btn btn-secondary rounded-pill text-start flex-grow-1"
                                    data-bs-toggle="modal"
                                    data-bs-target="#createPostModal">

                                What's on your mind, @User.Identity?.Name?

                            </button>

                        </div>

                        <hr class="border-secondary">

                        <div class="row g-2 text-center">

                            <div class="col-6">

                                <button type="button"
                                        class="btn btn-dark w-100"
                                        data-bs-toggle="modal"
                                        data-bs-target="#createPostModal">

                                    <i class="bi bi-image text-info me-2"></i>
                                    Add Photos

                                </button>

                            </div>

                            <div class="col-6">

                                <button type="button"
                                        class="btn btn-dark w-100"
                                        data-bs-toggle="modal"
                                        data-bs-target="#createPostModal">

                                    <i class="bi bi-file-text text-info me-2"></i>
                                    Text Post

                                </button>

                            </div>

                        </div>

                    </div>

                </section>

                @if (Model == null || !Model.Any())
                {
                    <section class="text-center py-5">

                        <i class="bi bi-newspaper display-4 text-secondary"></i>

                        <h5 class="fw-semibold mt-3">
                            No posts yet
                        </h5>

                        <p class="text-secondary">
                            Posts will appear here.
                        </p>

                    </section>
                }
                else
                {
                    @foreach (var post in Model)
                    {
                        <section class="card bg-dark border-secondary rounded-4 mb-3">

                            <div class="card-body p-3">

                                <div class="d-flex align-items-center gap-3 mb-3">

                                    <i class="bi bi-person-circle fs-2 text-secondary"></i>

                                    <div>

                                        <h6 class="fw-semibold text-info mb-1">
                                            @(post.User?.UserName ?? "Unknown User")
                                        </h6>

                                        <small class="text-secondary">
                                            @post.CreatedAt.ToLocalTime().ToString("g")
                                        </small>

                                    </div>

                                </div>

                                <p class="mb-3"
                                   style="white-space: pre-wrap;">
                                    @post.Content
                                </p>

                                @if (!string.IsNullOrEmpty(post.ImagePath))
                                {
                                    <img src="@Url.Content(post.ImagePath)"
                                         alt="Post image"
                                         class="img-fluid rounded-4 w-100"
                                         style="max-height: 500px; object-fit: contain;">
                                }

                            </div>

                        </section>
                    }
                }

            </main>

        </div>

    </div>

    <div class="modal fade"
         id="createPostModal"
         tabindex="-1"
         aria-labelledby="createPostTitle"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content bg-dark text-light">

                <form asp-controller="Home"
                      asp-action="CreatePost"
                      method="post"
                      enctype="multipart/form-data">

                    @Html.AntiForgeryToken()

                    <div class="modal-header border-secondary">

                        <h5 class="modal-title"
                            id="createPostTitle">

                            Create Post

                        </h5>

                        <button type="button"
                                class="btn-close btn-close-white"
                                data-bs-dismiss="modal"
                                aria-label="Close">
                        </button>

                    </div>

                    <div class="modal-body">

                        <label for="postText"
                               class="form-label">

                            What's on your mind?

                        </label>

                        <textarea name="content"
                                  class="form-control mb-3"
                                  id="postText"
                                  rows="4"
                                  maxlength="2000"
                                  placeholder="Write something..."
                                  required></textarea>

                        <label for="postImages"
                               class="form-label">

                            Add Photo (Optional)

                        </label>

                        <input type="file"
                               name="image"
                               class="form-control"
                               id="postImages"
                               accept=".jpg,.jpeg,.png,image/jpeg,image/png">

                    </div>

                    <div class="modal-footer border-secondary">

                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal">

                            Cancel

                        </button>

                        <button type="submit"
                                class="btn btn-info">

                            Post

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
